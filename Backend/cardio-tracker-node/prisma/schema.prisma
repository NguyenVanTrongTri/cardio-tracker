generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String               @id @db.VarChar(36)
  email                String               @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash         String?              @map("password_hash") @db.VarChar(255)
  fullName             String               @map("full_name") @db.VarChar(100)
  role                 Role                 @default(USER)
  gender               Gender?
  heightCm             Decimal?             @map("height_cm") @db.Decimal(5, 2)
  birthYear            Int?                 @map("birth_year")
  targetWaistCm        Decimal?             @map("target_waist_cm") @db.Decimal(5, 2)
  targetWeightKg       Decimal?             @map("target_weight_kg") @db.Decimal(5, 2)
  weightKg             Decimal?             @map("weight_kg") @db.Decimal(5, 2)
  targetDate           DateTime?            @map("target_date") @db.Date
  waistCm              Decimal?             @map("waist_cm") @db.Decimal(5, 2)
  hipCm                Decimal?             @map("hip_cm") @db.Decimal(5, 2)
  chestCm              Decimal?             @map("chest_cm") @db.Decimal(5, 2)
  bicepsCm             Decimal?             @map("biceps_cm") @db.Decimal(5, 2)
  thighCm              Decimal?             @map("thigh_cm") @db.Decimal(5, 2)
  neckCm               Decimal?             @map("neck_cm") @db.Decimal(5, 2)
  bodyFatPercentage    Decimal?             @map("body_fat_percentage") @db.Decimal(5, 2)
  activityLevel        ActivityLevel?       @map("activity_level")
  workoutEnvironment   WorkoutEnvironment?  @map("workout_environment")
  medicalConditions    String?              @map("medical_conditions") @db.Text
  medicalNotes         String?              @map("medical_notes") @db.Text
  weeklyGoalKg         Decimal?             @map("weekly_goal_kg") @db.Decimal(4, 2)
  createdAt            DateTime?            @default(now()) @map("created_at") @db.Timestamp(0)
  updated_at           DateTime?            @updatedAt @db.Timestamp(0)
  bodyMetrics          BodyMetric[]
  workouts             Workout[]

  @@map("users")
}

model BodyMetric {
  id         String   @id @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  metricDate DateTime @map("metric_date") @db.Date
  weightKg   Decimal? @map("weight_kg") @db.Decimal(5, 2)
  waistCm    Decimal? @map("waist_cm") @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamp(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_body_metrics_users")

  @@unique([userId, metricDate], map: "uq_user_metric_date")
  @@map("body_metrics")
}

model Workout {
  id               String           @id @db.VarChar(36)
  userId           String           @map("user_id") @db.VarChar(36)
  equipmentType    EquipmentType    @map("equipment_type")
  workoutStartTime DateTime         @map("workout_start_time") @db.DateTime(0)
  weightKg         Decimal?         @map("weight_kg") @db.Decimal(5, 2)
  waistCm          Decimal?         @map("waist_cm") @db.Decimal(5, 2)
  activeTime       Int?             @map("active_time")
  calories         Decimal?         @db.Decimal(7, 2)
  efficiencyIndex  Decimal?         @map("efficiency_index") @db.Decimal(5, 2)
  isZone2          Boolean          @default(false) @map("is_zone_2")
  cortisolAlert    Boolean          @default(false) @map("cortisol_alert")
  preWorkoutAlert  Boolean          @default(false) @map("pre_workout_alert")
  pauseDuration    Int              @default(0) @map("pause_duration")
  fatigueLevel     Int?             @map("fatigue_level") @db.TinyInt
  waterConsumedMl  Int              @default(0) @map("water_consumed_ml")
  totalDistanceKm  Decimal?         @map("total_distance_km") @db.Decimal(5, 2)
  notes            String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  meals            Meal[]
  workoutPhases    WorkoutPhase[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workouts_users")

  @@index([userId], map: "idx_workouts_user_id")
  @@index([workoutStartTime], map: "idx_workouts_start_time")
  @@map("workouts")
}

model WorkoutPhase {
  id               String           @id @db.VarChar(36)
  workoutId        String           @map("workout_id") @db.VarChar(36)
  phaseNumber      Int              @map("phase_number")
  name             String           @db.VarChar(100)
  durationMinutes  Int?             @map("duration_minutes")
  speedKmh         Decimal?         @map("speed_kmh") @db.Decimal(4, 1)
  inclineDegree    Decimal?         @map("incline_degree") @db.Decimal(4, 1)
  distanceKm       Decimal?         @map("distance_km") @db.Decimal(5, 2)
  isCoreEngaged    Boolean          @default(false) @map("is_core_engaged")
  subType          WorkoutSubType?  @map("sub_type")
  resistanceLevel  Decimal?         @map("resistance_level") @db.Decimal(4, 1)
  cadenceRpm       Int?             @map("cadence_rpm")
  strokeRateSpm    Int?             @map("stroke_rate_spm")
  stepsPerMin      Int?             @map("steps_per_min")
  workout          Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_workout_phases_workouts")

  @@index([workoutId], map: "idx_workout_phases_workout_id")
  @@map("workout_phases")
}

model Meal {
  id            String         @id @db.VarChar(36)
  workoutId     String         @map("workout_id") @db.VarChar(36)
  category      String         @db.VarChar(50)
  mealTime      String         @map("meal_time") @db.VarChar(20)
  totalCalories Decimal?       @map("total_calories") @db.Decimal(7, 2)
  foodItems     MealFoodItem[]
  workout       Workout        @relation(fields: [workoutId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_meals_workouts")

  @@index([workoutId], map: "idx_meals_workout_id")
  @@map("meals")
}

model MealFoodItem {
  id       String  @id @db.VarChar(36)
  mealId   String  @map("meal_id") @db.VarChar(36)
  foodName String  @map("food_name") @db.VarChar(255)
  grams    Decimal @db.Decimal(6, 2)
  calories Decimal @db.Decimal(6, 2)
  meal     Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_meal_food_items_meals")

  @@index([mealId], map: "idx_meal_food_items_meal_id")
  @@map("meal_food_items")
}

model migrations {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  migration String  @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

enum Role {
  ADMIN
  USER
}

enum Gender {
  MALE
  FEMALE
}

enum EquipmentType {
  TREADMILL
  STATIONARY_BIKE
  ROWING_MACHINE
  STAIR_CLIMBER
  OUTDOOR_RUN
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum WorkoutEnvironment {
  HOME
  GYM
}

enum WorkoutSubType {
  MAIN
  RELIEF
  SURGE
}